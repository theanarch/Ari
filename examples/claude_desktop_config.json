{
  "mcpServers": {
    "ari-documents": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "C:\\path\\to\\Ari",
        "ari-mcp",
        "--root",
        "C:\\path\\to\\your\\documents"
      ]
    },
    "ari-memory": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "C:\\path\\to\\Ari",
        "ari-memory"
      ],
      "env": {
        "ARI_MEMORY_CONNECTION_STRING": "Server=localhost;Database=<database>;UID=<login>;PWD=<password>;Encrypt=yes;TrustServerCertificate=yes"
      }
    }
  }
}
