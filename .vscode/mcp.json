{
  "inputs": [
    {
      "type": "promptString",
      "id": "docs-root",
      "description": "Folder with public documents for the Ari MCP server",
      "default": "C:\\Store\\Dokument"
    }
  ],
  "servers": {
    "ari-documents": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--directory", "${workspaceFolder}", "ari-mcp", "--root", "${input:docs-root}"]
    }
  }
}
